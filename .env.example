# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.
RAG_APP_NAME="RAG Assistant"
RAG_ENVIRONMENT=development

# Base de datos local (docker compose up -d db). Elige una contraseña y úsala en las dos URL.
RAG_DB_PASSWORD=cambia-esta-clave
RAG_DB_PORT=5442
RAG_DATABASE_URL=postgresql+psycopg://rag:cambia-esta-clave@127.0.0.1:5442/rag
# Base de las pruebas de integración; sin esta variable, esas pruebas se omiten.
RAG_TEST_DATABASE_URL=postgresql+psycopg://rag:cambia-esta-clave@127.0.0.1:5442/rag_test

# Ollama: instalado en el equipo o, sin GPU, en Docker (docker compose --profile ollama up -d).
RAG_OLLAMA_PORT=11434            # solo lo usa el Ollama de Docker
RAG_OLLAMA_URL=http://127.0.0.1:11434
RAG_EMBEDDING_MODEL=bge-m3
RAG_EMBEDDING_BATCH_SIZE=32
# Prueba de integración con Ollama real (requiere bge-m3 descargado); sin ella, se omite.
RAG_TEST_OLLAMA_URL=http://127.0.0.1:11434

# Modelo de lenguaje (RF-04): ollama | openai_compatible | anthropic.
RAG_LLM_PROVIDER=ollama
# Opcionales: sin ellos, cada proveedor usa su modelo y su tope por defecto
# (Ollama: qwen3.5:4b y 400; Anthropic: claude-opus-5-5 y 4096; compatible con OpenAI: 1024).
# RAG_LLM_MODEL=
# RAG_LLM_MAX_TOKENS=
# Proveedores remotos: la clave va solo aquí, nunca en el repositorio.
# RAG_LLM_API_KEY=
# Solo para openai_compatible (obligatorios ahí, junto con RAG_LLM_MODEL):
# RAG_LLM_BASE_URL=https://api.openai.com/v1

# Búsqueda: fragmentos por pregunta y similitud mínima para considerarlos relevantes.
RAG_RETRIEVAL_K=4
# Búsqueda híbrida: vectores + texto completo en español (false = solo vectores).
RAG_HYBRID_SEARCH=true
RAG_RELEVANCE_THRESHOLD=0.45
